# ============================================================
# UmlPilot Web - imagen de producción (Vite + React -> nginx)
# Build:  docker build -t umlpilot-web:latest -f Dockerfile.prod .
# ============================================================

# ---------- Etapa 1: build con Node + pnpm ----------
FROM node:22-alpine AS builder

WORKDIR /app

# El pnpm-lock.yaml está en formato 6.0 (pnpm 8)
RUN npm install -g pnpm@8.7.1

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm run build

# ---------- Etapa 2: servir con nginx ----------
FROM nginx:stable-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
