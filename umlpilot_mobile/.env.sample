# URL base del servidor Ollama (sin barra final)
# Escritorio / web local:      http://localhost:11434
# Emulador Android:            http://10.0.2.2:11434
# Dispositivo fisico:          http://<IP-de-tu-PC>:11434
# Requiere: adb reverse tcp:8080 tcp:8080
OLLAMA_URL=http://localhost:11434

# Modelo a usar (debe existir en `ollama list`)
OLLAMA_MODEL=llama3.2
