# ============================================================
# UmlPilot API - imagen de producción (Java 25 + Spring Boot 4)
# Build:  docker build -t umlpilot-api:latest -f Dockerfile.prod .
# ============================================================

# ---------- Etapa 1: build con Maven ----------
FROM maven:3.9-eclipse-temurin-25 AS builder

WORKDIR /build

# Cachea las dependencias (si falla un artefacto opcional, el package lo reportará)
COPY pom.xml .
RUN mvn -B -DskipTests -Dmaven.wagon.http.retryHandler.count=5 dependency:go-offline || true

COPY src ./src
RUN mvn -B -DskipTests -Dmaven.wagon.http.retryHandler.count=5 clean package

# ---------- Etapa 2: runtime ----------
# Alpine incluye wget (BusyBox): no se necesita apt-get ni curl en runtime.
FROM eclipse-temurin:25-jre-alpine

WORKDIR /app

COPY --from=builder /build/target/umlpilot_api-0.0.1-SNAPSHOT.jar app.jar

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
    CMD wget -qO- http://localhost:8080/health >/dev/null || exit 1

ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "app.jar"]
