# ============================================
# DATABASE - PostgreSQL
# ============================================
DB_NAME=umlpilot_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=55432

# ============================================
# SERVER
# ============================================
SERVER_PORT=8080

# ============================================
# CORS
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ============================================
# JWT - Authentication
# ============================================
JWT_SECRET=your-64-char-hex-secret-here
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ============================================
# SUPERADMIN - Bootstrap
# ============================================
SUPERADMIN_EMAIL=superadmin@umlpilot.local
SUPERADMIN_PASSWORD=SuperAdmin123!
SUPERADMIN_FIRST_NAME=Platform
SUPERADMIN_LAST_NAME=Admin

# ============================================
# SAMPLE DATA
# ============================================
SAMPLE_DATA_ENABLED=false

VITE_APP_NAME=UMLPilot
VITE_API_URL=http://localhost:8080

# ============================================
# AI - OpenRouter & Gemini
# Cada variable de API keys es una lista separada por comas (,)
# ============================================
AI_PROVIDER_ORDER=openrouter,gemini
OPENROUTER_API_KEYS=apikey1,apikey2
OPENROUTER_MODELS=nex-agi/nex-n2.5-pro:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,nex-agi/nex-n2.5-mini:free,google/gemma-4-26b-a4b-it:free,dots-studio/dots-3-note-preview:free,liquid/lfm-2.5-2.6b:free
GEMINI_API_KEYS=apikey1,apikey2
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
AI_QUOTA_COOLDOWN_SECONDS=300
AI_ERROR_COOLDOWN_SECONDS=30

# ============================================
# AI CHAT (asistente con function calling)
# provider: openrouter | gemini (vacío = primero configurado en provider-order)
# Rota automáticamente al otro proveedor cuando uno se queda sin créditos/cuota.
# ============================================
AI_CHAT_PROVIDER=
AI_CHAT_BASE_URL=https://openrouter.ai/api/v1
AI_CHAT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_CHAT_MAX_TOOL_CALLS=12
AI_CHAT_TIMEOUT_SECONDS=60

# Groq API Configuration (Whisper)
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3