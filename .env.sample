# ============================================
# DATABASE - PostgreSQL
# ============================================
DB_NAME=umlpilot_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=55432

# ============================================
# SERVER
# ============================================
SERVER_PORT=8080

# ============================================
# CORS
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ============================================
# JWT - Authentication
# ============================================
JWT_SECRET=your-64-char-hex-secret-here
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ============================================
# SUPERADMIN - Bootstrap
# ============================================
SUPERADMIN_EMAIL=superadmin@umlpilot.local
SUPERADMIN_PASSWORD=SuperAdmin123!
SUPERADMIN_FIRST_NAME=Platform
SUPERADMIN_LAST_NAME=Admin

# ============================================
# SAMPLE DATA
# ============================================
SAMPLE_DATA_ENABLED=false

VITE_APP_NAME=UMLPilot
VITE_API_URL=http://localhost:8080

# ============================================
# AI - OpenRouter & Gemini
# Cada variable de API keys es una lista separada por comas (,)
# ============================================
AI_PROVIDER_ORDER=openrouter,gemini
OPENROUTER_API_KEYS=
OPENROUTER_MODELS=deepseek/deepseek-chat,google/gemini-2.0-flash-001,meta-llama/llama-3.1-8b-instruct
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-flash
AI_QUOTA_COOLDOWN_SECONDS=300
AI_ERROR_COOLDOWN_SECONDS=30

# Groq API Configuration (Whisper)
GROQ_API_KEY=
GROQ_MODEL=